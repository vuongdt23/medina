# Copy to .env for docker compose development; do not commit local .env overrides.

# Include the web UI and Swagger assets in the image. Set false for API-only.
BUNDLE_FRONTEND=true

# Host-side URL http://127.0.0.1:8080
BIND_ADDRESS=0.0.0.0:8080
PORT=8080

# Container path where the course library is mounted.
CONTENT_ROOT=/library
LIBRARY_NAME=Development Library

# Persistent SQLite data in the named compose volume.
DATABASE_PATH=/data/course-media.sqlite

LOG_LEVEL=debug

# Full reconciliation fallback (mounts may not forward host filesystem events).
SCAN_INTERVAL=6h
SCAN_DEBOUNCE=2s
# Global limit for concurrent metadata requests.
SCAN_WORKERS=8
# Concurrent directory listings with bounded result prefetch.
SCAN_DIRECTORY_WORKERS=4
# Optional filesystem notifications; startup/manual/periodic scans always run.
SCAN_WATCH=true

# Optional local Grafana + Loki logging stack.
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Host path mounted read-only as CONTENT_ROOT. Override for a real library, e.g.:
# LIBRARY_MOUNT=/Volumes/Courses
LIBRARY_MOUNT=./testdata
